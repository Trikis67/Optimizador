{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Optimizador",
  "version": "0.3.0",
  "identifier": "com.gabriel.optimizador",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Optimizador · Trikis",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Trikis",
    "homepage": "https://trikis.nl/",
    "copyright": "© 2026 Gabriel Solis (Trikis)",
    "category": "Utility",
    "shortDescription": "Optimizador para PC",
    "longDescription": "Monitor de rendimiento, limpieza, ajustes, drivers y salud del sistema para Windows.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "installerHooks": "installer/hooks.nsh",
        "installMode": "perMachine",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Trikis",
        "template": "installer/installer.nsi"
      }
    }
  }
}
