{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Optimizador",
  "version": "0.2.0",
  "identifier": "com.gabriel.optimizador",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Optimizador",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
